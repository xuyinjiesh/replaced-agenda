# 运行时产物：可随时由流水线重建
data/raw/
data/cache/
data/runs/
data/audits/
data/seen.json
data/index.json
data/source-health.json
data/*.log

# 迁移前的本机历史数据备份，不属于正式事件集
data/legacy-events/

# site/ 需要提交：GitHub Pages 直接发布这份产物。
# 正式事件保存在 data/events/，site/ 是与之同步的可发布快照。
# 体积约 1.5 MB/次，每天一次提交，一年约 550 MB（可接受；真要瘦身可改用 --no-site 只推 gh-pages 分支）。

# 密钥等本地配置：绝不提交
.env
.env.*

# 但 config/ 与代码必须提交

node_modules/
.DS_Store

# 本地 UI handoff，仅供开发参考，不提交到 GitHub
/replaced-agenda-ui-handoff-2026-09-30/
